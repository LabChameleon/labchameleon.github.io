@article{DieEtAl2025,
  abbr={EWRL},
  title={Performance Prediction In Reinforcement Learning: The Bad And The Ugly},
  author={Dierkes, Julian and Eimer, Theresa and Lindauer, Marius and Hoos, Holger},
  abstract={We investigate surrogate models for predicting reinforcement learning performance from hyperparameter configurations. Rugged, noisy performance landscapes make accurate predictions difficult, and surrogate-based analyses can differ substantially from direct evaluations. These findings highlight limitations of current surrogate models for reinforcement learning benchmarking, hyperparameter interpretation and optimisation.},
  journal={18th European Workshop on Reinforcement Learning},
  year={2025},
  month={September},
  url={https://openreview.net/forum?id=L9J6Xmta4J},
  pdf={https://openreview.net/pdf?id=L9J6Xmta4J},
  selected={true},
}

